{
  "schema_version": "1.0",
  "family_id": "u1000_modern_deepsets",
  "scientific_question": "Does explicit periodic-kNN graph message passing improve Omega_m prediction beyond a permutation-invariant neural network receiving the exact same raw halo population?",
  "training_module": "src.evaluation.run_modern_deepsets",
  "output_root": "experiments",
  "model_family": "deepsets",
  "model": "DeepSets",
  "representation": "raw_halo_set",
  "uses_graph_edges": false,
  "snapshot_protocol": "final",
  "final_scale_factor": 1.0,
  "feature_names": ["log10_Mvir", "X", "Y", "Z", "VX", "VY", "VZ"],
  "feature_normalization": "none",
  "target": "Omega_m",
  "target_normalization": "none",
  "top_n": [500, 1000, 1500, 2000],
  "seeds": [42, 123, 2025],
  "expected_jobs": 12,
  "dataset_source_family": "configs/experiment_families/u1000_modern_classical_baselines.json",
  "fixed_configuration": {
    "architecture": "7-32-32-32_masked_mean_32-32-16-1",
    "activation": "ReLU",
    "dropout": 0.2,
    "layer_normalization": true,
    "same_width_residuals": true,
    "pooling": "masked_mean",
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.00001,
    "loss": "MSELoss",
    "batch_size": 8,
    "max_epochs": 300,
    "patience": 40,
    "checkpoint_criterion": "minimum_validation_mse",
    "scheduler": {"name": "ReduceLROnPlateau", "mode": "min", "factor": 0.5, "patience": 10, "min_lr": 0.000001},
    "gradient_clipping": 1.0,
    "num_workers": 0,
    "device": "cuda"
  },
  "exclusions": {"top750": true, "graph_edges": true, "feature_normalization": true, "target_normalization": true}
}
