{
  "schema_version": "1.0",
  "family_id": "canonical_evolvegcn_universe_scaling",
  "family_title": "Canonical EvolveGCN-H Top100 universe scaling",
  "scientific_question": "How does EvolveGCN-H Omega_m regression generalization change as the number of simulated universes increases while preprocessing, graph construction, architecture, optimization, and seed set remain fixed?",
  "model_name": "EvolveGCN-H",
  "training_module": "src.training.train_evolvegcn_h",
  "output_root": "experiments",
  "expected_artifacts": [
    "config.json",
    "metrics.json",
    "train_log.csv",
    "predictions/test_predictions.csv",
    "checkpoints/best_model.pt"
  ],
  "fixed_scientific_settings": {
    "config": {
      "model": "EvolveGCNHRegressor",
      "batch_size": 4,
      "epochs": 300,
      "patience": 40,
      "learning_rate": 0.001,
      "weight_decay": 0.00001,
      "hidden_dim": 32,
      "num_layers": 2,
      "dropout": 0.2,
      "activation": "relu",
      "temporal_pooling": "mean",
      "graph_pooling": "mean",
      "head_type": "mlp",
      "add_self_loops": true,
      "train_ratio": 0.7,
      "val_ratio": 0.15,
      "test_ratio": 0.15,
      "grad_clip_norm": 1.0,
      "use_summary_features": false,
      "normalize_target": false,
      "num_snapshots": 5,
      "num_nodes": 100,
      "node_features": 7
    },
    "legacy_config_defaults": {
      "activation": "relu",
      "head_type": "mlp",
      "use_summary_features": false,
      "normalize_target": false
    },
    "dataset_metadata": {
      "num_snapshots": 5,
      "num_nodes": 100,
      "normalization": "minmax",
      "graph_mode": "knn",
      "k": 8,
      "periodic_boundary": true,
      "periodic_boundary_knn": true,
      "box_size": 25.0,
      "feature_names": [
        "log10_Mvir",
        "X",
        "Y",
        "Z",
        "VX",
        "VY",
        "VZ"
      ]
    }
  },
  "allowed_varying_fields": [
    "universes",
    "seed",
    "dataset_path",
    "experiment_name",
    "experiment_path",
    "train_ids",
    "val_ids",
    "test_ids",
    "num_train_universes",
    "num_val_universes",
    "num_test_universes",
    "device",
    "trainable_parameters"
  ],
  "required_seeds": [
    42,
    123,
    2025
  ],
  "grouping_field": "universes",
  "grouping_values": [
    20,
    50,
    100,
    200,
    500
  ],
  "grouping_config_field": "num_total_universes",
  "grouping_metadata_field": "num_universes_successful",
  "aggregation_metrics": [
    "test_mae",
    "test_rmse",
    "test_r2",
    "test_pearson"
  ],
  "prediction_file": "predictions/test_predictions.csv",
  "target_column_aliases": [
    "true_omega_m",
    "target",
    "y_true"
  ],
  "prediction_column_aliases": [
    "pred_omega_m",
    "prediction",
    "y_pred"
  ],
  "metric_tolerance": 0.000001,
  "registry": {
    "experiments_root": "experiments",
    "report_directory": "reports/experiment_registry"
