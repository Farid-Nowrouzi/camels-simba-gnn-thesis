{
  "schema_version": "1.0",
  "family_id": "canonical_static_gcn_universe_scaling",
  "family_title": "Canonical Static GCN Top100 universe scaling",
  "scientific_question": "How does final-snapshot Static GCN Omega_m regression generalization change as the number of simulated universes increases while preprocessing, graph construction, architecture, optimization, split assignments, and seed set remain fixed?",
  "model_name": "Static GCN",
  "training_module": "src.training.train_static_gcn",
  "output_root": "experiments",
  "expected_artifacts": [
    "config.json",
    "metrics.json",
    "train_log.csv",
    "predictions/test_predictions.csv",
    "checkpoints/best_model.pt"
  ],
  "fixed_scientific_settings": {
    "config": {
      "model": "StaticGCNRegressor",
      "dataset_format": "static",
      "batch_size": 8,
      "epochs": 300,
      "patience": 40,
      "learning_rate": 0.001,
      "weight_decay": 0.00001,
      "hidden_dim": 32,
      "num_layers": 2,
      "dropout": 0.2,
      "activation": "relu",
      "graph_pooling": "mean",
      "conv_type": "gcn",
      "head_type": "established_static_mlp",
      "add_self_loops": true,
      "train_ratio": 0.7,
      "val_ratio": 0.15,
      "test_ratio": 0.15,
      "grad_clip_norm": 1.0,
      "use_summary_features": false,
      "normalize_target": false,
      "num_nodes": 100,
      "node_features": 7
    },
    "legacy_config_defaults": {
      "dataset_format": "static",
      "activation": "relu",
      "conv_type": "gcn",
      "head_type": "established_static_mlp",
